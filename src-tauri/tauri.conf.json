{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local API Vault",
  "mainBinaryName": "local-api-vault",
  "version": "0.1.0",
  "identifier": "dev.localapivault.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Local API Vault",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/lvault.cmd": "lvault.cmd"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
